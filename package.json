{
  "name": "ble-scale-sync",
  "version": "1.27.0",
  "description": "Universal BLE Smart Scale bridge. Captures body composition from Renpho, Xiaomi & 20+ others, syncs to Garmin Connect, Strava, MQTT (Home Assistant), InfluxDB, Webhooks, Ntfy & local files. Headless CLI for Raspberry Pi, Linux, macOS & Windows.",
  "type": "module",
  "bin": {
    "ble-scale-sync": "dist/index.js"
  },
  "files": [
    "dist/",
    "garmin-scripts/*.py",
    "requirements.txt",
    "config.yaml.example",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristianP26/ble-scale-sync.git"
  },
  "bugs": {
    "url": "https://github.com/KristianP26/ble-scale-sync/issues"
  },
  "homepage": "https://blescalesync.dev",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "setup": "tsx src/wizard/index.ts",
    "setup-garmin": "tsx src/setup-garmin.ts",
    "setup-strava": "tsx src/exporters/strava-setup.ts",
    "scan": "tsx src/scan.ts",
    "diagnose": "tsx src/diagnose.ts",
    "validate": "tsx src/config/validate-cli.ts",
    "sync:addon-changelog": "tsx src/tools/sync-addon-changelog.ts",
    "sync:addon-changelog:check": "tsx src/tools/sync-addon-changelog.ts check",
    "test": "vitest run",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "smart-scale",
    "garmin",
    "scale",
    "ble",
    "bluetooth",
    "body-composition",
    "health"
  ],
  "author": "Kristián Partl",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@2colors/esphome-native-api": "^1.3.6",
    "@inquirer/prompts": "^8.7.0",
    "aedes": "^1.1.1",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "dotenv": "^17.4.2",
    "encoding": "^0.1.13",
    "mqtt": "^5.15.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.2"
  },
  "optionalDependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "@stoprocent/noble": "^2.7.1",
    "node-ble": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
