# Environment & secrets
.env
config.yaml
!ble-scale-sync-addon/config.yaml
config.yaml.bak
config.yaml.tmp

# Node.js
node_modules/
dist/
# Vitest 5 writes blob/json/junit reports and attachments here
.vitest/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
env/
venv/

# IDE & tools
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Legacy config (pre-v2)
config.py

# ESP32 firmware config (contains WiFi/MQTT credentials)
firmware/config.json
firmware/*.bin

# Garmin tokens (should not be committed). garmin-tokens/ is the setup
# wizard's default token_dir, the dot-directories are the Python default.
.garmin_tokens/
.garmin_renpho_tokens/
garmin-tokens/

# Docker Compose (local overrides)
docker-compose.override.yml

# Strava tokens (should not be committed)
strava-tokens/

# Data files (file exporter output and the export retry queue hold names
# and body composition)
*.csv
*.jsonl
.export-retry-queue.jsonl*

# Update check cooldown state (runtime artifact, written next to config.yaml)
.update-check-state.json
.update-check-state.json.tmp

# Scale adapter de-duplication marks (runtime artifact, written next to config.yaml)
.scale-dedup-marks.json
.scale-dedup-marks.json.tmp

# VitePress
docs/.vitepress/dist/
docs/.vitepress/cache/
